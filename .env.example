# Kopiér til .env og udfyld. .env må ALDRIG komme på GitHub.

# Administrator – kun til migrationer
DATABASE_URL=postgres://postgres:kun-lokalt@localhost:5432/postgres

# Bruges af tests (opretter og sletter sin egen database)
TEST_DATABASE_URL=postgres://postgres:kun-lokalt@localhost:5432/postgres

# API
PORT=3000
HOST=127.0.0.1

# Login (passkeys er bundet til adressen)
ORIGIN=http://localhost:3000
# Programmets egen database-bruger (medlem af jhfs_app, ALDRIG administrator)
DATABASE_APP_URL=postgres://jhfs_web:skift-mig@localhost:5432/postgres
SESSION_DAGE=14

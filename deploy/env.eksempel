# Kopiér til deploy/.env på serveren:  cp env.eksempel .env && chmod 600 .env
# Lav kodeord med:  openssl rand -hex 32
# .env må ALDRIG komme på GitHub.

DOMAENE=core.jhfarmsupport.dk
DB_ADMIN_KODE=
DB_APP_KODE=

# Backup (Hetzner Storage Box). Se docs/drift/server.md trin 9.
# RESTIC_PASSWORD skal OGSÅ skrives ned på papir – uden den kan backuppen ikke åbnes.
RESTIC_REPOSITORY=sftp:storagebox:jhfs-backup
RESTIC_PASSWORD=
